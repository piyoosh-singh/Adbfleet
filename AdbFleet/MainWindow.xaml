<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="AdbFleet.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:m="using:AdbFleet.Models"
    Title="AdbFleet">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Grid x:Name="AppTitleBar" Padding="14,0,140,0" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image Source="ms-appx:///Assets/AdbFleet.png" Width="18" Height="18" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="AdbFleet" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="2" Text="{x:Bind Devices.Status, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" Margin="12,0,0,0"
                       TextTrimming="CharacterEllipsis" />
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="316" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Device rail -->
            <Grid Padding="12,4,8,12" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Padding="4,0,0,0">
                    <TextBlock Text="Devices" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="2">
                        <Button Style="{StaticResource SubtleButtonStyle}" Click="CheckAll_Click" ToolTipService.ToolTip="Check every ready device">
                            <FontIcon Glyph="&#xE762;" FontSize="14" />
                        </Button>
                        <Button Style="{StaticResource SubtleButtonStyle}" Click="UncheckAll_Click" ToolTipService.ToolTip="Uncheck all devices">
                            <FontIcon Glyph="&#xE8E6;" FontSize="14" />
                        </Button>
                    </StackPanel>
                </Grid>

                <ListView x:Name="DeviceList" Grid.Row="1" ItemsSource="{x:Bind Devices.All}"
                          SelectionMode="Single" SelectionChanged="DeviceList_SelectionChanged" Padding="0">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="m:Device">
                            <Grid Padding="0,10" ColumnSpacing="8" Background="Transparent"
                                  RightTapped="DeviceRow_RightTapped" DoubleTapped="DeviceRow_DoubleTapped">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Rectangle Fill="{x:Bind Brush}" RadiusX="2" RadiusY="2" />
                                <CheckBox Grid.Column="1" MinWidth="0" Margin="4,0,0,0" VerticalAlignment="Center"
                                          IsChecked="{x:Bind IsChecked, Mode=TwoWay}" IsEnabled="{x:Bind IsOnline, Mode=OneWay}"
                                          ToolTipService.ToolTip="Include this device in actions" />
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <Grid Width="11" Height="11" VerticalAlignment="Center" Background="Transparent"
                                              ToolTipService.ToolTip="{x:Bind ReachText, Mode=OneWay}">
                                            <Ellipse Width="9" Height="9" Fill="{x:Bind ReachBrush, Mode=OneWay}" />
                                            <ProgressRing IsActive="{x:Bind IsChecking, Mode=OneWay}" Width="11" Height="11" MinWidth="11" MinHeight="11" />
                                        </Grid>
                                        <TextBlock Text="{x:Bind DisplayName, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="150" Opacity="{x:Bind RowOpacity, Mode=OneWay}"
                                                   ToolTipService.ToolTip="{x:Bind SummaryTip, Mode=OneWay}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="6" Opacity="{x:Bind RowOpacity, Mode=OneWay}">
                                        <FontIcon Glyph="{x:Bind TransportGlyph}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                  ToolTipService.ToolTip="{x:Bind TransportText}" />
                                        <TextBlock Text="{x:Bind AddressText, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="150"
                                                   IsTextSelectionEnabled="False" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="6" Visibility="{x:Bind ProxyVisibility, Mode=OneWay}" Background="Transparent"
                                                ToolTipService.ToolTip="This device sends its web traffic through a proxy. Remove it from the ⋯ menu or Tools → Proxy.">
                                        <FontIcon Glyph="&#xE774;" FontSize="12" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                        <TextBlock Text="{x:Bind ProxyBadge, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                                   Foreground="{ThemeResource SystemFillColorCautionBrush}" TextTrimming="CharacterEllipsis" MaxWidth="150" />
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind Subtitle, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" MaxWidth="160" />
                                </StackPanel>
                                <Grid Grid.Column="3" VerticalAlignment="Center">
                                    <ProgressRing IsActive="{x:Bind IsBusy, Mode=OneWay}" Width="16" Height="16" />
                                    <FontIcon Glyph="{x:Bind ResultGlyph, Mode=OneWay}" FontSize="14" Foreground="{x:Bind ResultBrush, Mode=OneWay}"
                                              Visibility="{x:Bind ResultVisibility, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind RunMessage, Mode=OneWay}" />
                                </Grid>
                                <Button Grid.Column="4" Style="{StaticResource SubtleButtonStyle}" Padding="6" VerticalAlignment="Center"
                                        Click="DeviceMore_Click" ToolTipService.ToolTip="More options" AutomationProperties.Name="More options">
                                    <FontIcon Glyph="&#xE712;" FontSize="14" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel x:Name="EmptyRail" Grid.Row="1" VerticalAlignment="Center" Spacing="8" Padding="12,0" Visibility="Collapsed">
                    <TextBlock Text="No devices yet" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Connect a phone or TV with USB debugging turned on, or connect over Wi-Fi. Every device you add shows up here, and you can work with all of them at once." />
                </StackPanel>

                <Grid Grid.Row="2" ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}" Click="Connect_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE701;" FontSize="14" />
                            <TextBlock Text="Connect over Wi-Fi" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="RefreshButton" Grid.Column="1" Click="RefreshAvailability_Click" AutomationProperties.Name="Check availability"
                            ToolTipService.ToolTip="Ping every device to see which are reachable, and reconnect reachable Wi-Fi devices">
                        <Grid>
                            <FontIcon x:Name="RefreshIcon" Glyph="&#xE72C;" FontSize="14" />
                            <ProgressRing x:Name="RefreshRing" IsActive="False" Width="16" Height="16" MinWidth="16" MinHeight="16" />
                        </Grid>
                    </Button>
                </Grid>
            </Grid>

            <!-- Work area -->
            <NavigationView x:Name="Nav" Grid.Column="1" PaneDisplayMode="Top" IsBackButtonVisible="Collapsed"
                            IsSettingsVisible="True" SelectionChanged="Nav_SelectionChanged">
                <NavigationView.MenuItems>
                    <NavigationViewItem Content="Overview" Tag="overview">
                        <NavigationViewItem.Icon><FontIcon Glyph="&#xE7F4;" /></NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="Apps" Tag="apps" Icon="AllApps" />
                    <NavigationViewItem Content="Install" Tag="install" Icon="Download" />
                    <NavigationViewItem Content="Tools" Tag="tools" Icon="Repair" />
                    <NavigationViewItem Content="Console" Tag="console">
                        <NavigationViewItem.Icon><FontIcon Glyph="&#xE756;" /></NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="Processes" Tag="processes">
                        <NavigationViewItem.Icon><FontIcon Glyph="&#xE9D9;" /></NavigationViewItem.Icon>
                    </NavigationViewItem>
                </NavigationView.MenuItems>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Which devices the next action touches -->
                    <Grid Padding="24,10,24,6" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TargetText" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <ScrollViewer Grid.Column="1" HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Hidden" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                            <ItemsRepeater x:Name="TargetChips">
                                <ItemsRepeater.Layout>
                                    <StackLayout Orientation="Horizontal" Spacing="6" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="m:Device">
                                        <Border CornerRadius="12" Padding="10,3,10,3" BorderThickness="1" BorderBrush="{x:Bind Brush}"
                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}" ToolTipService.ToolTip="{x:Bind RunMessage, Mode=OneWay}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Ellipse Width="8" Height="8" Fill="{x:Bind Brush}" VerticalAlignment="Center" />
                                                <TextBlock Text="{x:Bind DisplayName, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                                                <ProgressRing IsActive="{x:Bind IsBusy, Mode=OneWay}" Width="12" Height="12" MinWidth="12" MinHeight="12" />
                                                <FontIcon Glyph="{x:Bind ResultGlyph, Mode=OneWay}" FontSize="11" Foreground="{x:Bind ResultBrush, Mode=OneWay}"
                                                          Visibility="{x:Bind ResultVisibility, Mode=OneWay}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </ScrollViewer>
                    </Grid>

                    <Frame x:Name="ContentFrame" Grid.Row="1" />
                </Grid>
            </NavigationView>
        </Grid>
    </Grid>
</Window>
