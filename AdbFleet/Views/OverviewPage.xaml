<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AdbFleet.Views.OverviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:m="using:AdbFleet.Models"
    NavigationCacheMode="Required">

    <Page.Resources>
        <!-- One label/value line in a details card. -->
        <DataTemplate x:Key="FactTemplate" x:DataType="m:Fact">
            <Grid ColumnSpacing="12" Padding="0,5" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind Label}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Top" />
                <TextBlock Grid.Column="1" Text="{x:Bind Value}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
            </Grid>
        </DataTemplate>

        <Style x:Key="MetricValue" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="HeaderCell" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Page.Resources>

    <Grid>
        <!-- Nothing selected -->
        <StackPanel x:Name="EmptyView" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420" Spacing="8" Visibility="Collapsed">
            <TextBlock Text="No device selected" Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock Style="{StaticResource Hint}" FontSize="14"
                       Text="Select a device on the left to see its details. Check two or more devices to compare them side by side." />
        </StackPanel>

        <!-- ================= One device ================= -->
        <ScrollViewer x:Name="SingleView" Visibility="Collapsed">
            <StackPanel Padding="24,4,24,24" Spacing="16">
                <!-- Header -->
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Rectangle x:Name="HeadBar" RadiusX="3" RadiusY="3" />
                    <StackPanel Grid.Column="1" Spacing="6">
                        <TextBlock x:Name="HeadName" Style="{StaticResource TitleTextBlockStyle}" TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True" />
                        <StackPanel x:Name="HeadFacts" Orientation="Horizontal" Spacing="18">
                            <TextBlock x:Name="HeadAndroid" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon x:Name="HeadTransportIcon" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="HeadConnection" FontFamily="{StaticResource MonoFont}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" IsTextSelectionEnabled="True" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Ellipse x:Name="HeadReachDot" Width="9" Height="9" VerticalAlignment="Center" />
                                <TextBlock x:Name="HeadReach" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <StackPanel x:Name="HeadProxy" Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE774;" FontSize="13" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                <TextBlock x:Name="HeadProxyText" FontFamily="{StaticResource MonoFont}" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Top">
                        <TextBlock x:Name="ReadAt" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                        <Button x:Name="CopyButton" Click="Copy_Click" ToolTipService.ToolTip="Copy all details as text" AutomationProperties.Name="Copy details">
                            <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                        </Button>
                        <Button x:Name="RefreshSingle" Click="Refresh_Click" AutomationProperties.Name="Refresh details">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Grid>
                                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                </Grid>
                                <TextBlock Text="Refresh" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <InfoBar x:Name="OfflineBar" IsOpen="False" IsClosable="False" Severity="Informational" />

                <!-- Live measurements -->
                <Grid x:Name="Metrics" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Panel}">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Storage" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="StorageValue" Style="{StaticResource MetricValue}" />
                            <ProgressBar x:Name="StorageBar" Maximum="100" />
                            <TextBlock x:Name="StorageNote" Style="{StaticResource Hint}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource Panel}">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Memory" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="MemoryValue" Style="{StaticResource MetricValue}" />
                            <ProgressBar x:Name="MemoryBar" Maximum="100" />
                            <TextBlock x:Name="MemoryNote" Style="{StaticResource Hint}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Panel}">
                        <StackPanel Spacing="6">
                            <TextBlock x:Name="ThirdLabel" Text="Battery" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="ThirdValue" Style="{StaticResource MetricValue}" />
                            <ProgressBar x:Name="ThirdBar" Maximum="100" />
                            <TextBlock x:Name="ThirdNote" Style="{StaticResource Hint}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Details -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Panel}" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="System" Style="{StaticResource SectionTitle}" />
                            <ItemsControl x:Name="SystemList" ItemTemplate="{StaticResource FactTemplate}" />
                        </StackPanel>
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="12">
                        <Border Style="{StaticResource Panel}">
                            <StackPanel>
                                <TextBlock Text="Display" Style="{StaticResource SectionTitle}" />
                                <ItemsControl x:Name="DisplayList" ItemTemplate="{StaticResource FactTemplate}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Panel}">
                            <StackPanel>
                                <TextBlock Text="Network" Style="{StaticResource SectionTitle}" />
                                <ItemsControl x:Name="NetworkList" ItemTemplate="{StaticResource FactTemplate}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- ================= Several devices: comparison table ================= -->
        <Grid x:Name="TableView" Padding="24,4,24,16" RowSpacing="12" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2">
                    <TextBlock x:Name="TableTitle" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock Style="{StaticResource Hint}" Text="Amber values need a look: under 10% storage or memory free, a security patch over two years old, low battery, or a proxy that is on. Click a column to sort." />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                    <Button Click="CopyCsv_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                            <TextBlock Text="Copy as CSV" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="RefreshTable" Click="Refresh_Click" AutomationProperties.Name="Refresh details">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                            <TextBlock Text="Refresh" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Style="{StaticResource Panel}" Padding="0">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Auto" VerticalScrollBarVisibility="Disabled" VerticalScrollMode="Disabled">
                    <Grid MinWidth="1040">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <!-- Column header: widths must match the row template below. -->
                        <Grid Padding="8,4" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="72" />
                                <ColumnDefinition Width="86" />
                                <ColumnDefinition Width="132" />
                                <ColumnDefinition Width="132" />
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="76" />
                                <ColumnDefinition Width="104" />
                                <ColumnDefinition Width="*" MinWidth="90" />
                            </Grid.ColumnDefinitions>
                            <Button Style="{StaticResource HeaderCell}" Tag="name" Click="Sort_Click" Content="Device" />
                            <Button Grid.Column="1" Style="{StaticResource HeaderCell}" Tag="android" Click="Sort_Click" Content="Android" />
                            <Button Grid.Column="2" Style="{StaticResource HeaderCell}" Tag="patch" Click="Sort_Click" Content="Patch" />
                            <Button Grid.Column="3" Style="{StaticResource HeaderCell}" Tag="storage" Click="Sort_Click" Content="Storage free" />
                            <Button Grid.Column="4" Style="{StaticResource HeaderCell}" Tag="memory" Click="Sort_Click" Content="Memory free" />
                            <Button Grid.Column="6" Style="{StaticResource HeaderCell}" Tag="battery" Click="Sort_Click" Content="Battery" />
                            <Button Grid.Column="7" Style="{StaticResource HeaderCell}" Tag="screen" Click="Sort_Click" Content="Screen" />
                            <Button Grid.Column="8" Style="{StaticResource HeaderCell}" Tag="uptime" Click="Sort_Click" Content="Up time" />
                            <Button Grid.Column="5" Style="{StaticResource HeaderCell}" Tag="proxy" Click="Sort_Click" Content="Proxy" />
                        </Grid>
                        <ListView x:Name="Table" Grid.Row="1" SelectionMode="None" IsItemClickEnabled="True" ItemClick="Table_ItemClick" Padding="0,0,0,8">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                                    <Setter Property="Padding" Value="8,0" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="m:Device">
                                    <Grid Padding="0,8" ColumnSpacing="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220" />
                                            <ColumnDefinition Width="72" />
                                            <ColumnDefinition Width="86" />
                                            <ColumnDefinition Width="132" />
                                            <ColumnDefinition Width="132" />
                                            <ColumnDefinition Width="180" />
                                            <ColumnDefinition Width="76" />
                                            <ColumnDefinition Width="104" />
                                            <ColumnDefinition Width="*" MinWidth="90" />
                                        </Grid.ColumnDefinitions>
                                        <Grid ColumnSpacing="10" Padding="8,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="4" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Rectangle Fill="{x:Bind Brush}" RadiusX="2" RadiusY="2" />
                                            <StackPanel Grid.Column="1">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Text="{x:Bind DisplayName, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" MaxWidth="170" />
                                                    <ProgressRing IsActive="{x:Bind InfoLoading, Mode=OneWay}" Width="12" Height="12" MinWidth="12" MinHeight="12" />
                                                </StackPanel>
                                                <TextBlock Text="{x:Bind ConnectionText, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Grid.Column="1" Padding="8,0" VerticalAlignment="Center" Text="{x:Bind AndroidVersion, Mode=OneWay}" />
                                        <TextBlock Grid.Column="2" Padding="8,0" VerticalAlignment="Center" Text="{x:Bind Info.PatchShort, Mode=OneWay, FallbackValue='–'}" Foreground="{x:Bind PatchBrush, Mode=OneWay}" />
                                        <StackPanel Grid.Column="3" Padding="8,0" VerticalAlignment="Center" Spacing="4">
                                            <TextBlock Text="{x:Bind Info.StorageShort, Mode=OneWay, FallbackValue='–'}" Foreground="{x:Bind StorageBrush, Mode=OneWay}" />
                                            <ProgressBar Value="{x:Bind Info.StorageUsedPercent, Mode=OneWay, FallbackValue=0}" Maximum="100" Width="104" HorizontalAlignment="Left" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="4" Padding="8,0" VerticalAlignment="Center" Spacing="4">
                                            <TextBlock Text="{x:Bind Info.MemoryShort, Mode=OneWay, FallbackValue='–'}" Foreground="{x:Bind MemoryBrush, Mode=OneWay}" />
                                            <ProgressBar Value="{x:Bind Info.MemoryUsedPercent, Mode=OneWay, FallbackValue=0}" Maximum="100" Width="104" HorizontalAlignment="Left" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="6" Padding="8,0" VerticalAlignment="Center" Text="{x:Bind Info.BatteryShort, Mode=OneWay, FallbackValue='–'}" Foreground="{x:Bind BatteryBrush, Mode=OneWay}" />
                                        <TextBlock Grid.Column="7" Padding="8,0" VerticalAlignment="Center" Text="{x:Bind Info.ScreenShort, Mode=OneWay, FallbackValue='–'}" />
                                        <TextBlock Grid.Column="8" Padding="8,0" VerticalAlignment="Center" Text="{x:Bind Info.UptimeText, Mode=OneWay, FallbackValue='–'}" />
                                        <TextBlock Grid.Column="5" Padding="8,0" VerticalAlignment="Center" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                                   Text="{x:Bind ProxyStatus, Mode=OneWay}" Foreground="{x:Bind ProxyBrush, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>
