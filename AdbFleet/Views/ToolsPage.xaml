<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AdbFleet.Views.ToolsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:m="using:AdbFleet.Models"
    NavigationCacheMode="Required">

    <Page.Resources>
        <Style x:Key="KeyButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Height" Value="40" />
        </Style>
    </Page.Resources>

    <ScrollViewer>
        <Grid Padding="24,4,24,24" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="16">
                <!-- Remote control -->
                <Border Style="{StaticResource Panel}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Remote control" Style="{StaticResource SectionTitle}" />
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <!-- D-pad for TVs and boxes -->
                            <Grid Width="156" Height="156" RowSpacing="4" ColumnSpacing="4">
                                <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <Button Grid.Column="1" Tag="KEYCODE_DPAD_UP" Click="Key_Click" Style="{StaticResource KeyButton}" Height="48" ToolTipService.ToolTip="Up"><FontIcon Glyph="&#xE70E;" FontSize="14" /></Button>
                                <Button Grid.Row="1" Tag="KEYCODE_DPAD_LEFT" Click="Key_Click" Style="{StaticResource KeyButton}" Height="48" ToolTipService.ToolTip="Left"><FontIcon Glyph="&#xE76B;" FontSize="14" /></Button>
                                <Button Grid.Row="1" Grid.Column="1" Tag="KEYCODE_DPAD_CENTER" Click="Key_Click" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Height="48" Content="OK" />
                                <Button Grid.Row="1" Grid.Column="2" Tag="KEYCODE_DPAD_RIGHT" Click="Key_Click" Style="{StaticResource KeyButton}" Height="48" ToolTipService.ToolTip="Right"><FontIcon Glyph="&#xE76C;" FontSize="14" /></Button>
                                <Button Grid.Row="2" Grid.Column="1" Tag="KEYCODE_DPAD_DOWN" Click="Key_Click" Style="{StaticResource KeyButton}" Height="48" ToolTipService.ToolTip="Down"><FontIcon Glyph="&#xE70D;" FontSize="14" /></Button>
                            </Grid>
                            <Grid Grid.Column="1" RowSpacing="4" ColumnSpacing="4">
                                <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <Button Tag="KEYCODE_BACK" Click="Key_Click" Style="{StaticResource KeyButton}" Content="Back" />
                                <Button Grid.Column="1" Tag="KEYCODE_HOME" Click="Key_Click" Style="{StaticResource KeyButton}" Content="Home" />
                                <Button Grid.Column="2" Tag="KEYCODE_APP_SWITCH" Click="Key_Click" Style="{StaticResource KeyButton}" Content="Recents" />
                                <Button Grid.Row="1" Tag="KEYCODE_VOLUME_DOWN" Click="Key_Click" Style="{StaticResource KeyButton}" Content="Volume −" />
                                <Button Grid.Row="1" Grid.Column="1" Tag="KEYCODE_VOLUME_MUTE" Click="Key_Click" Style="{StaticResource KeyButton}" Content="Mute" />
                                <Button Grid.Row="1" Grid.Column="2" Tag="KEYCODE_VOLUME_UP" Click="Key_Click" Style="{StaticResource KeyButton}" Content="Volume +" />
                                <Button Grid.Row="2" Tag="KEYCODE_MENU" Click="Key_Click" Style="{StaticResource KeyButton}" Content="Menu" />
                                <Button Grid.Row="2" Grid.Column="1" Tag="KEYCODE_WAKEUP" Click="Key_Click" Style="{StaticResource KeyButton}" Content="Wake" />
                                <Button Grid.Row="2" Grid.Column="2" Tag="KEYCODE_POWER" Click="Key_Click" Style="{StaticResource KeyButton}" Content="Power" />
                            </Grid>
                        </Grid>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TypeBox" PlaceholderText="Type text into the focused field on the device" KeyDown="TypeBox_KeyDown" />
                            <Button Grid.Column="1" Content="Send text" Click="SendText_Click" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Display -->
                <Border Style="{StaticResource Panel}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Display size and density" Style="{StaticResource SectionTitle}" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="SizeBox" Header="Resolution" PlaceholderText="1920x1080" />
                            <TextBox x:Name="DensityBox" Grid.Column="1" Header="Density (dpi)" PlaceholderText="320" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Apply" Click="ApplyScreen_Click" />
                            <Button Content="Reset to default" Click="ResetScreen_Click" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Hint}" Text="Leave a box empty to keep its current value. Reset restores the device's own size and density." />
                    </StackPanel>
                </Border>

                <!-- Power -->
                <Border Style="{StaticResource Panel}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Restart and power" Style="{StaticResource SectionTitle}" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="RebootMode" HorizontalAlignment="Stretch" SelectedIndex="0">
                                <ComboBoxItem Content="Restart" Tag="" />
                                <ComboBoxItem Content="Restart to recovery" Tag="recovery" />
                                <ComboBoxItem Content="Restart to bootloader" Tag="bootloader" />
                                <ComboBoxItem Content="Restart to sideload" Tag="sideload" />
                                <ComboBoxItem Content="Power off" Tag="poweroff" />
                            </ComboBox>
                            <Button Grid.Column="1" Content="Run" Click="Reboot_Click" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="1" Spacing="16">
                <!-- Mirroring -->
                <Border Style="{StaticResource Panel}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Screen mirroring" Style="{StaticResource SectionTitle}" />
                        <TextBlock x:Name="ScrcpyStatus" Style="{StaticResource Hint}" />
                        <StackPanel Spacing="4">
                            <TextBlock Text="Extra scrcpy options" />
                            <TextBox x:Name="ScrcpyArgs" FontFamily="{StaticResource MonoFont}" LostFocus="ScrcpyArgs_LostFocus" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Style="{StaticResource AccentButtonStyle}" Click="Mirror_Click" Tag="">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE7F4;" FontSize="14" />
                                    <TextBlock Text="Mirror screen" />
                                </StackPanel>
                            </Button>
                            <Button Content="Mirror and record" Click="Mirror_Click" Tag="record" />
                            <Button Content="Camera" Click="Mirror_Click" Tag="--video-source=camera" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Hint}" Text="Opens one window per device. Recordings are saved to your screenshots folder." />
                    </StackPanel>
                </Border>

                <!-- Screenshot + Wireless -->
                <Border Style="{StaticResource Panel}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Capture and connect" Style="{StaticResource SectionTitle}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Click="Screenshot_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE722;" FontSize="14" />
                                    <TextBlock Text="Take screenshot" />
                                </StackPanel>
                            </Button>
                            <Button Content="Open screenshots folder" Click="OpenShots_Click" />
                        </StackPanel>
                        <Button Content="Switch USB devices to Wi-Fi debugging" Click="Wifi_Click" />
                        <TextBlock Style="{StaticResource Hint}" Text="For devices plugged in by USB: turns on network debugging on port 5555 and connects over Wi-Fi, so you can unplug the cable. The cable connection drops for a moment while it switches. The device goes back to USB only after it restarts; on Android 11 and later, Wireless debugging (Pair in Connect over Wi-Fi) stays on instead." />
                    </StackPanel>
                </Border>

                <!-- Proxy -->
                <Border Style="{StaticResource Panel}">
                    <StackPanel Spacing="10">
                        <Grid>
                            <TextBlock Text="Proxy" Style="{StaticResource SectionTitle}" />
                            <Button x:Name="ProxyCheckButton" HorizontalAlignment="Right" Style="{StaticResource SubtleButtonStyle}" Click="ProxyCheck_Click"
                                    ToolTipService.ToolTip="Check the proxy setting again" AutomationProperties.Name="Check proxy">
                                <FontIcon Glyph="&#xE72C;" FontSize="14" />
                            </Button>
                        </Grid>
                        <ItemsControl x:Name="ProxyList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="m:Device">
                                    <Grid ColumnSpacing="10" Margin="0,2" MinHeight="32">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Width="8" Height="8" Fill="{x:Bind Brush}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind DisplayName, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE774;" FontSize="12" Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                                          Visibility="{x:Bind ProxyVisibility, Mode=OneWay}" />
                                                <TextBlock Text="{x:Bind ProxyStatus, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" IsTextSelectionEnabled="True" />
                                            </StackPanel>
                                        </StackPanel>
                                        <Button Grid.Column="2" Content="Remove" Click="ProxyRemoveOne_Click" VerticalAlignment="Center"
                                                Visibility="{x:Bind ProxyVisibility, Mode=OneWay}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="ProxyEmpty" Style="{StaticResource Hint}" Text="Select a device on the left to see its proxy." Visibility="Collapsed" />

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="110" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="ProxyHost" Header="Proxy address" IsEditable="True" HorizontalAlignment="Stretch" SelectionChanged="ProxyHost_SelectionChanged" />
                            <NumberBox x:Name="ProxyPort" Grid.Column="1" Header="Port" Minimum="1" Maximum="65535"
                                       SpinButtonPlacementMode="Hidden" ValidationMode="InvalidInputOverwritten" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Style="{StaticResource AccentButtonStyle}" Click="ProxySet_Click" Content="Set proxy" />
                            <Button x:Name="ProxyRemoveAll" Click="ProxyRemoveAll_Click" Content="Remove proxy" />
                        </StackPanel>
                        <TextBlock x:Name="ProxyHint" Style="{StaticResource Hint}" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
