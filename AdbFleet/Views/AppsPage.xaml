<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AdbFleet.Views.AppsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:m="using:AdbFleet.Models"
    NavigationCacheMode="Required">

    <Grid Padding="24,4,24,16" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Ellipse x:Name="SourceDot" Width="10" Height="10" VerticalAlignment="Center" />
            <TextBlock x:Name="SourceText" Grid.Column="1" Style="{StaticResource SubtitleTextBlockStyle}" Text="Apps" TextTrimming="CharacterEllipsis" />
            <Button Grid.Column="2" Click="Refresh_Click" ToolTipService.ToolTip="Reload the app list">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                    <TextBlock Text="Refresh" />
                </StackPanel>
            </Button>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <AutoSuggestBox x:Name="SearchBox" VerticalAlignment="Center" PlaceholderText="Search by package name" QueryIcon="Find" TextChanged="Search_TextChanged" />
            <SelectorBar x:Name="FilterBar" Grid.Column="1" SelectionChanged="FilterBar_SelectionChanged">
                <SelectorBarItem Text="User apps" Tag="user" IsSelected="True" />
                <SelectorBarItem Text="System apps" Tag="system" />
                <SelectorBarItem Text="Disabled" Tag="disabled" />
                <SelectorBarItem Text="Removed" Tag="removed" />
                <SelectorBarItem Text="All" Tag="all" />
            </SelectorBar>
        </Grid>

        <Grid Grid.Row="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <CommandBar x:Name="Actions" HorizontalAlignment="Left" DefaultLabelPosition="Right" IsEnabled="False" Background="Transparent">
                <AppBarButton Label="Disable" Click="Disable_Click" ToolTipService.ToolTip="Turn the app off without removing it">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE7BA;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Label="Enable" Click="Enable_Click" ToolTipService.ToolTip="Turn a disabled app back on">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE73E;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Label="Uninstall" Icon="Delete" Click="Uninstall_Click" ToolTipService.ToolTip="Remove the app for the current user" />
                <AppBarButton Label="Restore" Icon="Undo" Click="Restore_Click" ToolTipService.ToolTip="Bring back a removed system app" />
                <AppBarButton Label="Save APK" Icon="Save" Click="SaveApk_Click" ToolTipService.ToolTip="Copy the app's APK files to this PC" />
                <CommandBar.SecondaryCommands>
                    <AppBarButton Label="Launch" Icon="Play" Click="Launch_Click" />
                    <AppBarButton Label="Force stop" Icon="Stop" Click="ForceStop_Click" />
                    <AppBarButton Label="Clear data" Icon="Clear" Click="Clear_Click" />
                </CommandBar.SecondaryCommands>
            </CommandBar>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock x:Name="SelectedText" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <DropDownButton Content="Presets">
                    <DropDownButton.Flyout>
                        <MenuFlyout x:Name="PresetMenu" Opening="PresetMenu_Opening" />
                    </DropDownButton.Flyout>
                </DropDownButton>
                <Button Content="Select all shown" Click="SelectAll_Click" />
                <Button Content="Clear selection" Click="ClearSel_Click" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="3" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <ListView x:Name="AppList" SelectionMode="Multiple" SelectionChanged="AppList_SelectionChanged"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8"
                      Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="m:AppInfo">
                        <Grid Padding="0,6" ColumnSpacing="12" Opacity="{x:Bind Dim}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="64" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Package}" FontFamily="{StaticResource MonoFont}" FontSize="13" TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="False" />
                                <TextBlock Text="{x:Bind ApkPath}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Border Grid.Column="1" Visibility="{x:Bind StateVisibility}" CornerRadius="4" Padding="6,1"
                                    Background="{ThemeResource SystemFillColorCautionBackgroundBrush}" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind StateText}" Style="{StaticResource CaptionTextBlockStyle}" />
                            </Border>
                            <TextBlock Grid.Column="2" Text="{x:Bind KindText}" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8" MaxWidth="380" Visibility="Collapsed">
                <TextBlock x:Name="EmptyTitle" Style="{StaticResource BodyStrongTextBlockStyle}" HorizontalAlignment="Center" />
                <TextBlock x:Name="EmptyBody" Style="{StaticResource Hint}" TextAlignment="Center" />
            </StackPanel>
            <ProgressRing x:Name="LoadingRing" IsActive="False" Width="40" Height="40" />

            <Border Grid.Column="1" Style="{StaticResource Panel}" VerticalAlignment="Stretch">
                <ScrollViewer>
                    <StackPanel Spacing="10">
                        <TextBlock Text="Details" Style="{StaticResource SectionTitle}" />
                        <TextBlock x:Name="DetailPkg" FontFamily="{StaticResource MonoFont}" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                   Text="Select an app to see its version and install details." />
                        <ProgressRing x:Name="DetailLoading" IsActive="False" HorizontalAlignment="Left" Width="20" Height="20" />
                        <ItemsControl x:Name="DetailItems">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="m:Fact">
                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock Text="{x:Bind Label}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{x:Bind Value}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>
