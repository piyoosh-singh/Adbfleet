<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AdbFleet.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="24,4,24,24" Spacing="16" MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock Text="Settings" Style="{StaticResource SubtitleTextBlockStyle}" />

            <Border Style="{StaticResource Panel}">
                <StackPanel Spacing="10">
                    <TextBlock Text="adb" Style="{StaticResource SectionTitle}" />
                    <TextBlock x:Name="AdbStatus" Style="{StaticResource Hint}" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="AdbPath" PlaceholderText="Found automatically" FontFamily="{StaticResource MonoFont}" LostFocus="AdbPath_LostFocus" />
                        <Button Grid.Column="1" Content="Browse" Click="BrowseAdb_Click" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="DownloadAdb" Content="Download latest platform-tools" Click="DownloadAdb_Click" />
                        <Button Content="Restart adb server" Click="RestartAdb_Click" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="platform-tools comes from Google's official download. If another program uses a different adb version, the two keep restarting each other; point both at the same adb.exe." />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Panel}">
                <StackPanel Spacing="10">
                    <TextBlock Text="scrcpy (screen mirroring)" Style="{StaticResource SectionTitle}" />
                    <TextBlock x:Name="ScrcpyStatus" Style="{StaticResource Hint}" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ScrcpyPath" PlaceholderText="Found automatically" FontFamily="{StaticResource MonoFont}" LostFocus="ScrcpyPath_LostFocus" />
                        <Button Grid.Column="1" Content="Browse" Click="BrowseScrcpy_Click" />
                    </Grid>
                    <Button x:Name="DownloadScrcpy" Content="Download latest scrcpy" Click="DownloadScrcpy_Click" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Panel}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Folders" Style="{StaticResource SectionTitle}" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="DownloadsDir" Header="Saved APKs and logs" IsReadOnly="True" />
                        <Button Grid.Column="1" Content="Change" Click="ChangeDownloads_Click" VerticalAlignment="Bottom" />
                    </Grid>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ShotsDir" Header="Screenshots and recordings" IsReadOnly="True" />
                        <Button Grid.Column="1" Content="Change" Click="ChangeShots_Click" VerticalAlignment="Bottom" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Panel}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Apps" Style="{StaticResource SectionTitle}" />
                    <NumberBox x:Name="UserId" Header="Android user ID" Minimum="0" Maximum="999" SpinButtonPlacementMode="Compact"
                               HorizontalAlignment="Left" Width="200" ValueChanged="UserId_ValueChanged" />
                    <TextBlock Style="{StaticResource Hint}" Text="0 is the main user. Change this only to manage a work profile or a second user on the device." />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Panel}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Appearance" Style="{StaticResource SectionTitle}" />
                    <RadioButtons x:Name="ThemeChoice" SelectionChanged="Theme_SelectionChanged" MaxColumns="3">
                        <x:String>System</x:String>
                        <x:String>Light</x:String>
                        <x:String>Dark</x:String>
                    </RadioButtons>
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource Hint}" x:Name="AboutText" />
        </StackPanel>
    </ScrollViewer>
</Page>
