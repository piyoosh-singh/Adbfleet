<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="AdbFleet.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Brand accent: deep teal, overriding the system accent so the app keeps one identity. -->
            <Color x:Key="SystemAccentColor">#1F7A6E</Color>
            <Color x:Key="SystemAccentColorDark1">#18695E</Color>
            <Color x:Key="SystemAccentColorDark2">#145C54</Color>
            <Color x:Key="SystemAccentColorDark3">#0E463F</Color>
            <Color x:Key="SystemAccentColorLight1">#2E9E8F</Color>
            <Color x:Key="SystemAccentColorLight2">#5CC2B0</Color>
            <Color x:Key="SystemAccentColorLight3">#8ADBC9</Color>

            <FontFamily x:Key="MonoFont">Cascadia Mono, Cascadia Code, Consolas</FontFamily>

            <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="Margin" Value="0,0,0,8" />
            </Style>
            <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="Panel" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="16" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
